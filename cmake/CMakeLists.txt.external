# Plotting tools
include(ExternalProject)
include(FetchContent)

# TBB
function(YARR_ADD_TBB)
    if (TARGET tbb_2020)
        message(WARNING "already defined")
        return()
    endif()

    #needed as otherwise the directory does not exist during configure step and cmake throws an error as it has not been built/installed yet
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/include")
    
    # -- Generate helper CMake script
    file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/copy_tbb_libs.cmake
    "
    file(GLOB_RECURSE TBB_STATIC_LIBS
        \"${CMAKE_CURRENT_BINARY_DIR}/external/src/tbb_2020/build/*/*.a\"
    )

    file(MAKE_DIRECTORY \"${CMAKE_CURRENT_BINARY_DIR}/lib\")

    foreach(LIB \${TBB_STATIC_LIBS})
        file(COPY \${LIB} DESTINATION \"${CMAKE_CURRENT_BINARY_DIR}/lib\")
    endforeach()
    ")

    ExternalProject_Add(
        tbb_2020
        PATCH_COMMAND git apply ${PROJECT_SOURCE_DIR}/cmake/0001-TBB-GCC13.patch
        GIT_REPOSITORY https://github.com/intel/tbb.git
        GIT_TAG 2020_U2
        UPDATE_COMMAND ""
        CONFIGURE_COMMAND ""
        BUILD_COMMAND ${CMAKE_COMMAND} -E chdir <SOURCE_DIR> make -j4 ${TBB_COMP} ${TBB_ARCH} extra_inc=big_iron.inc
        INSTALL_COMMAND 
            ${CMAKE_COMMAND} -E make_directory ${CMAKE_CURRENT_BINARY_DIR}/include
            COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_CURRENT_BINARY_DIR}/lib
            COMMAND ${CMAKE_COMMAND} -E copy_directory <SOURCE_DIR>/include/tbb ${CMAKE_CURRENT_BINARY_DIR}/include/tbb
            COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_BINARY_DIR}/copy_tbb_libs.cmake
        PREFIX "${CMAKE_CURRENT_BINARY_DIR}/external"
    )

    # Create an imported target manually
    add_library(tbb::tbb STATIC IMPORTED GLOBAL)

    # Tell CMake where to find the library + includes once the build is done
    set_target_properties(tbb::tbb PROPERTIES
       IMPORTED_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/lib/libtbb.a"
       INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_BINARY_DIR}/include"
    )
    
    add_library(tbb::tbbmalloc STATIC IMPORTED GLOBAL)
    add_library(tbb::tbbmalloc_proxy STATIC IMPORTED GLOBAL)

    set_target_properties(tbb::tbbmalloc PROPERTIES
       IMPORTED_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/lib/libtbbmalloc.a"
       INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_BINARY_DIR}/include"
    )

    set_target_properties(tbb::tbbmalloc_proxy PROPERTIES
       IMPORTED_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/lib/libtbbmalloc_proxy.a"
       INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_BINARY_DIR}/include"
    )
    
    add_dependencies(tbb::tbb tbb_2020)
    add_dependencies(tbb::tbbmalloc tbb_2020)
    add_dependencies(tbb::tbbmalloc_proxy tbb_2020)

endfunction()

function(YARR_ADD_NETIO)
    if (TARGET netio4)
        return()
    endif()

    # NetIO
    ExternalProject_Add (
        netio4
        GIT_REPOSITORY https://:@gitlab.cern.ch:8443/atlas-tdaq-felix/netio.git
        GIT_TAG netio-11-01-00
        UPDATE_COMMAND ""
        PATCH_COMMAND cp ${PROJECT_SOURCE_DIR}/cmake/CMakeLists.txt.netio ${CMAKE_CURRENT_BINARY_DIR}/external/src/netio4/CMakeLists.txt
        INSTALL_COMMAND ""
        PREFIX "${CMAKE_CURRENT_BINARY_DIR}/external"
        CMAKE_ARGS "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}" -DCMAKE_CXX_FLAGS=-fPIC
        DEPENDS tbb_2020
        )

    include_directories(${CMAKE_CURRENT_BINARY_DIR}/external/src/netio4)
    link_directories(${CMAKE_CURRENT_BINARY_DIR}/external/src/netio4-build)
endfunction()

function(YARR_ADD_FELIX)
    if (TARGET felixbase4)
        return()
    endif()

    # FELIX
    ExternalProject_Add (
        felixbase4
        GIT_REPOSITORY https://:@gitlab.cern.ch:8443/atlas-tdaq-felix/felixbase.git
        GIT_TAG felix-4.0.x
        UPDATE_COMMAND ""
        PATCH_COMMAND ""
        INSTALL_COMMAND ""
        CONFIGURE_COMMAND ""
        BUILD_COMMAND ""
        PREFIX "${CMAKE_CURRENT_BINARY_DIR}/external"
        DEPENDS netio4
        )

    include_directories(${CMAKE_CURRENT_BINARY_DIR}/external/src/felixbase4)
endfunction()

function(YARR_ADD_FELIX_CLIENT)
    # FELIX Client Thread
    FetchContent_Declare (
        felixclientthread
        GIT_REPOSITORY https://gitlab.cern.ch/atlas-tdaq-felix/felix-client-thread.git
        GIT_TAG master
        UPDATE_COMMAND ""
        PATCH_COMMAND 
             cp ${PROJECT_SOURCE_DIR}/cmake/CMakeLists.txt.felix-client-thread CMakeLists.txt 
        )
        
   FetchContent_MakeAvailable(felixclientthread)

endfunction()

function(YARR_ADD_EXTERNAL_DEPS)
    # spdlog
    FetchContent_Declare(
        spdlog
        GIT_REPOSITORY  https://gitlab.cern.ch/atlas-sw-misc/spdlog.git
        GIT_TAG v1.9.2.x
    )
    
   FetchContent_Populate(spdlog)

   # Create a custom header-only target for spdlog as the export does not work properly in version 1.9.2.x To be re-visited if it gets updated.
   add_library(yarrspdlog INTERFACE)

   target_include_directories(yarrspdlog INTERFACE
      "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
      "$<BUILD_INTERFACE:${spdlog_SOURCE_DIR}/include>"
   )

   # Dependencies of yarrspdlog
   find_package(Threads)
   target_link_libraries(yarrspdlog INTERFACE Threads::Threads)

   # Level below which logger macros are not enabled
   target_compile_definitions(yarrspdlog INTERFACE SPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_${YARR_ACTIVE_LOGGER_LEVEL})

   # Export the target manually
   install(TARGETS yarrspdlog EXPORT YarrTargets)

   # Install the headers and the target

   install(DIRECTORY ${spdlog_SOURCE_DIR}/include/
      DESTINATION ${CMAKE_INSTALL_PREFIX}/include
   )

endfunction()

function(YARR_ADD_PYBIND11)
   FetchContent_Declare(
       pybind11
       GIT_REPOSITORY https://github.com/pybind/pybind11.git
       GIT_TAG v2.9.2
       SOURCE_SUBDIR pybind11
   )
   FetchContent_GetProperties(pybind11)
   if(NOT pybind11_POPULATED)
       FetchContent_Populate(pybind11)
       add_subdirectory(${pybind11_SOURCE_DIR} ${pybind11_BINARY_DIR})
   endif()
endfunction()
