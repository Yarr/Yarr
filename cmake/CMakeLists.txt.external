# Plotting tools
include(ExternalProject)
include(FetchContent)

include(cmake/SupportFunctionsLibrary.cmake)

if(YARR_FELIX_BACKEND)
    # It has been already included previously.
    return()
endif()

set(USE_SYSTEM_FELIX OFF)
set(Felix_ROOT "" CACHE PATH "Path to pre-compiled FELIX")
if (NOT "${Felix_ROOT}" STREQUAL "")
    set(USE_SYSTEM_FELIX ON)
    set(YARR_FELIX_BACKEND "NONE" PARENT_SCOPE)
endif()

function(YARR_ADD_FELIX_CLIENT)
    set(YARR_FELIX_BACKEND "NONE" PARENT_SCOPE)
    if (TARGET tdaq::felix_proxy)
        message(STATUS "TDAQ is available, using felix-proxy instead")

        set(YARR_FELIX_BACKEND "FELIX_PROXY" PARENT_SCOPE)
        # Just works, with tdaq_add_library tdaq::felix_proxy
        return()
    endif()

    if (USE_SYSTEM_FELIX)
        message(STATUS "Using pre-compiled FELIX from ${Felix_ROOT}")
        find_package(Felix REQUIRED COMPONENTS felix-client-thread felix-interface HINTS "${Felix_ROOT}")
        set(YARR_FELIX_BACKEND "FELIX_CLIENT_SYSTEM" PARENT_SCOPE)
        return()
    endif()

   if((CMAKE_CXX_COMPILER_VERSION VERSION_LESS 15.0) AND (CMAKE_CXX_COMPILER_ID STREQUAL "GNU"))
        message(STATUS "Cannot build FELIX with GCC version < 15.")
   else()
     # FELIX Client Thread
     FetchContent_Declare (
          felixinterface
          GIT_REPOSITORY https://gitlab.cern.ch/atlas-tdaq-felix/felix-interface.git
          GIT_TAG master
          UPDATE_COMMAND ""
          PATCH_COMMAND 
               cp ${PROJECT_SOURCE_DIR}/cmake/felix-interface-patches/CMakeLists.txt.felix-interface CMakeLists.txt &&
               cp ${PROJECT_SOURCE_DIR}/cmake/felix-interface-patches/felix-interfaceConfig.cmake.in felix-interfaceConfig.cmake.in
          )
        
      FetchContent_MakeAvailable(felixinterface)
    
      FetchContent_Declare (
          felixclientthread
          GIT_REPOSITORY https://gitlab.cern.ch/atlas-tdaq-felix/felix-client-thread.git
          GIT_TAG master
          UPDATE_COMMAND ""
          PATCH_COMMAND 
               cp ${PROJECT_SOURCE_DIR}/cmake/felix-client-thread-patches/CMakeLists.txt.felix-client-thread CMakeLists.txt &&
               cp ${PROJECT_SOURCE_DIR}/cmake/felix-client-thread-patches/felix-client-threadConfig.cmake.in felix-client-threadConfig.cmake.in
          )
        
       FetchContent_MakeAvailable(felixclientthread)
       set(YARR_FELIX_BACKEND "FELIX_CLIENT_EMBEDDED" PARENT_SCOPE)
       return()
    endif()
    
    message(WARNING "Attempt to get any version of FELIX failed.")

endfunction()

include(CMakeDependentOption)
option(YARR_USE_FETCHCONTENT_SPDLOG "Use FetchContent to get spdlog if not found" ON)
cmake_dependent_option(YARR_FORCE_FETCHCONTENT_SPDLOG "Force FetchContent even if spdlog is found" OFF YARR_USE_FETCHCONTENT_SPDLOG OFF)

# Consistency checks
if(YARR_FORCE_FETCHCONTENT_SPDLOG AND NOT YARR_USE_FETCHCONTENT_SPDLOG)
  message(FATAL_ERROR "YARR_FORCE_FETCHCONTENT_SPDLOG requires YARR_USE_FETCHCONTENT_SPDLOG to be ON.")
endif()

# Determine the mode as a string (for caching and comparison)
if(YARR_FORCE_FETCHCONTENT_SPDLOG)
  set(YARR_SPDLOG_BACKEND "FORCE_FETCHCONTENT")
elseif(YARR_USE_FETCHCONTENT_SPDLOG)
  set(YARR_SPDLOG_BACKEND "FETCH_IF_NOT_FOUND")
else()
  set(YARR_SPDLOG_BACKEND "FIND_PACKAGE")
endif()

# Save this mode to the cache
set(YARR_SPDLOG_BACKEND ${YARR_SPDLOG_BACKEND} CACHE STRING "How spdlog was integrated in the build")

# Compare against previous config if already defined
if(DEFINED YARR_SPDLOG_BACKEND_PREV)
    if(NOT YARR_SPDLOG_BACKEND STREQUAL YARR_SPDLOG_BACKEND_PREV)
        message(WARNING "Changing spdlog backend integration mode from ${YARR_SPDLOG_BACKEND_PREV} to ${YARR_SPDLOG_BACKEND}. This may cause problems if the build directory is not cleaned. Consider removing your build dir or clearing the CMake cache.")
    endif()
endif()

# Save the current mode for future comparisons
set(YARR_SPDLOG_BACKEND_PREV ${YARR_SPDLOG_BACKEND} CACHE INTERNAL "Previous spdlog integration mode")


function(YARR_ADD_SPDLOG)

    # Skip everything if the target already exists as it was already added by the parent project (likely).
    if(TARGET yarrspdlog)
        message(STATUS "Using existing spdlog target: yarrspdlog is already defined which indicates that at some point the function YARR_ADD_EXTERNAL_DEPS gets called for a second time. Re-running cmake configure step?")
        return()
    endif()
    
    if(TARGET spdlog::spdlog)
        message(STATUS "Using existing spdlog target (spdlog::spdlog already defined). Added by parent project?")
        if(NOT CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
            message(STATUS "Yes, seems like YARR is getting built by another project by using add_subdirectory() or FetchContent(). Strong indication that this is where we got spdlog.")
        else()
            message(STATUS "No, it has to be something else.")
        endif()
        
        message(STATUS "In any case defining yarrspdlog using the existing spdlog::spdlog target.")
        add_library(yarrspdlog INTERFACE)
        target_link_libraries(yarrspdlog INTERFACE spdlog::spdlog)
        target_compile_definitions(yarrspdlog INTERFACE SPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_${YARR_ACTIVE_LOGGER_LEVEL})
        
        
        target_link_libraries(yarrspdlog INTERFACE
            $<BUILD_INTERFACE:spdlog::spdlog>
        )
        
        install(TARGETS yarrspdlog EXPORT YarrTargets)
        
        set(YARR_HAS_BUILTIN_SPDLOG FALSE CACHE INTERNAL "Whether Yarr provides its own spdlog")
        return()
    endif()
    
    if(NOT YARR_FORCE_FETCHCONTENT_SPDLOG)
        message(STATUS "Trying to find system spdlog.")
        cmake_policy(PUSH)
        if(POLICY CMP0144)
            cmake_policy(SET CMP0144 NEW)
        else()
            if(DEFINED ENV{spdlog_ROOT} AND NOT DEFINED ENV{SPDLOG_ROOT})
                set(ENV{SPDLOG_ROOT} "$ENV{spdlog_ROOT}")
            endif()
        endif()
        find_package(spdlog QUIET)
        cmake_policy(POP)
        if(spdlog_FOUND)
            message(STATUS "Using system provided spdlog")

            add_library(yarrspdlog INTERFACE)
            target_link_libraries(yarrspdlog INTERFACE spdlog::spdlog_header_only)
            target_compile_definitions(yarrspdlog INTERFACE SPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_${YARR_ACTIVE_LOGGER_LEVEL})
            install(TARGETS yarrspdlog EXPORT YarrTargets)
            
            set(YARR_HAS_BUILTIN_SPDLOG FALSE CACHE INTERNAL "Whether Yarr provides its own spdlog")    
            return()
         else()
             message(STATUS "No system spdlog found.")
         endif()
    endif()
    
    if(YARR_USE_FETCHCONTENT_SPDLOG)
       message(STATUS "Downloading spdlog library.")
       FetchContent_Declare(
           spdlog
           GIT_REPOSITORY  https://github.com/gabime/spdlog.git
           GIT_TAG v1.15.3
       )
    
       FetchContent_Populate(spdlog)

       # Create a custom header-only target for spdlog as the export does not work properly in version 1.9.2.x To be re-visited if it gets updated.
       add_library(yarrspdlog INTERFACE)

       target_include_directories(yarrspdlog INTERFACE
          "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
          "$<BUILD_INTERFACE:${spdlog_SOURCE_DIR}/include>"
       )

       # Dependencies of yarrspdlog
       find_package(Threads)
       target_link_libraries(yarrspdlog INTERFACE Threads::Threads)

       # Level below which logger macros are not enabled
       target_compile_definitions(yarrspdlog INTERFACE SPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_${YARR_ACTIVE_LOGGER_LEVEL})

       # Export the target manually
       install(TARGETS yarrspdlog EXPORT YarrTargets)

       # Install the headers and the target

       install(DIRECTORY ${spdlog_SOURCE_DIR}/include/
          DESTINATION ${CMAKE_INSTALL_PREFIX}/include
       )
       set(YARR_HAS_BUILTIN_SPDLOG TRUE CACHE INTERNAL "Whether Yarr provides its own spdlog")
       return()
    endif()
    message(FATAL_ERROR "spdlog not found and either failed no not allowed to fetch it (check YARR_USE_FETCHCONTENT_SPDLOG and YARR_FORCE_FETCHCONTENT_SPDLOG)")
endfunction()

function(YARR_ADD_PYBIND11)
   FetchContent_Declare(
       pybind11
       GIT_REPOSITORY https://github.com/pybind/pybind11.git
       GIT_TAG v2.13.6
#       SOURCE_SUBDIR pybind11
   )
   FetchContent_MakeAvailable(pybind11)
endfunction()
