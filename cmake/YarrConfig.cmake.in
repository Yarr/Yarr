@PACKAGE_INIT@

# always necessary includes
include(CMakeFindDependencyMacro)

# List of known components
set(_YARR_KNOWN_COMPONENTS
    Spec
    Emu
    Bdaq
    FelixClient
    ItsdaqFW
    StarEmu
    Fei4Emu
    Rd53aEmu
    Fei4
    Rd53a
    Rd53b
    Star
    Itkpixv2
    Itkpixv2Emu
)

# dependencies that are always needed
find_package(Threads REQUIRED)

# persisten information about the build
set(YARR_HAS_BUILTIN_SPDLOG @YARR_HAS_BUILTIN_SPDLOG@)
set(YARR_FELIX_BACKEND "@YARR_FELIX_BACKEND@")

if(YARR_HAS_BUILTIN_SPDLOG)
  message(STATUS "This YARR comes with an integrated spdlog library.")
else()
  message(STATUS "YARR has not been built with an integrated spdlog. This dependency has to be provided separately.")
  find_dependency(spdlog REQUIRED)
endif()

# version and base targets
include("${CMAKE_CURRENT_LIST_DIR}/YarrConfigVersion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/YarrTargets.cmake")

# load all component targets that exist
foreach(comp IN LISTS _YARR_KNOWN_COMPONENTS)
    set(_comp_file "${CMAKE_CURRENT_LIST_DIR}/Yarr_${comp}Targets.cmake")
    if(EXISTS "${_comp_file}")
        if("${comp}" STREQUAL "Bdaq")
           find_package(Boost REQUIRED COMPONENTS system) 
        endif()
        if("${comp}" STREQUAL "FelixClient")
            if(YARR_FELIX_BACKEND STREQUAL "FELIX_PROXY")
                find_dependency(tdaq REQUIRED COMPONENTS felix_proxy)
            elseif(YARR_FELIX_BACKEND STREQUAL "FELIX_CLIENT_SYSTEM")
                find_dependency(Felix REQUIRED COMPONENTS felix-def felix-client-thread felix-interface)
            elseif(YARR_FELIX_BACKEND STREQUAL "FELIX_CLIENT_EMBEDDED")
                find_dependency(felix-def REQUIRED)
                find_dependency(felix-interface REQUIRED)
                find_dependency(felix-client-thread REQUIRED)
            elseif(YARR_FELIX_BACKEND STREQUAL "NONE")
                message(FATAL_ERROR
                    "YARR FelixClient component was installed, but YARR_FELIX_BACKEND=NONE."
                    "This indicates an inconsistent installation.")
            else()
                message(FATAL_ERROR
                    "Unknown YARR_FELIX_BACKEND='${YARR_FELIX_BACKEND}' in installed YARR package.")
            endif()
        endif()
        include("${_comp_file}")
        set(YARR_${comp}_FOUND TRUE)
        list(APPEND YARR_FOUND_COMPONENTS ${comp})
    else()
        set(YARR_${comp}_FOUND FALSE)
    endif()
endforeach()

# check that all REQUIRED components were found
set(Yarr_FOUND TRUE)
foreach(comp IN LISTS YARR_FIND_COMPONENTS)
    if(NOT YARR_${comp}_FOUND)
        if(YARR_FIND_REQUIRED_${comp})
            message(FATAL_ERROR "Required YARR component '${comp}' not found")
        endif()
        set(Yarr_FOUND FALSE)
    endif()
endforeach()


