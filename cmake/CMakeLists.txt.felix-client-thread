cmake_minimum_required(VERSION 3.15)

project(felix-client-thread LANGUAGES CXX VERSION 0.0.1)

include(GNUInstallDirs)

add_library(felix-client-thread SHARED src/felix_client_thread.cpp)
target_link_libraries(felix-client-thread dl pthread)
target_include_directories(felix-client-thread PRIVATE ${CMAKE_SOURCE_DIR}/felix-interface)
target_include_directories(felix-client-thread PRIVATE  ${CMAKE_SOURCE_DIR})
   
install(TARGETS felix-client-thread
    EXPORT felix-client-threadTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  )

install(DIRECTORY felix/
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
    FILES_MATCHING
        PATTERN "*.hpp"
)

# Install the export set for use with the install-tree
install(EXPORT felix-client-threadTargets
  NAMESPACE felix::
  DESTINATION cmake
)
