cmake_minimum_required(VERSION 3.15.0)

project(netio LANGUAGES CXX VERSION 0.8.0)

set(CMAKE_POSITION_INDEPENDENT_CODE ON)

include(GNUInstallDirs)
set(CMAKE_CONFIG_INSTALL_PATH ${CMAKE_INSTALL_LIBDIR}/cmake/netio)

set(VERSION_STRING ${CMAKE_PROJECT_VERSION})
configure_file(
   ${CMAKE_CURRENT_SOURCE_DIR}/src/config.h.in 
   ${CMAKE_CURRENT_BINARY_DIR}/config.h NEWLINE_STYLE UNIX)
   
option(NETIO4_BUILD_TESTS "Build netio4 executables" OFF)
   
#########start FIND DEPENDENCIES#####
   
#########start DEPENDENCY #1 LIBFABRIC#####
option(NETIO4_FORCE_USE_BUILTIN_LIBFABRIC "Force building libfabric from source" OFF)

include(FetchContent)
include(ExternalProject)

# === Priority 1: target already defined which we are included in another cmake  project which already provides it===
if(NOT TARGET libfabric::libfabric)

    # === Priority 2: System-provided ===
    if(NOT NETIO4_FORCE_USE_BUILTIN_LIBFABRIC)
        list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
        find_package(LIBFABRIC QUIET)

        if(TARGET libfabric::libfabric)
            message(STATUS "libfabric found by netio as system provided")
        endif()
    endif()

    # === Priority 3: External build ===
    if(NOT TARGET libfabric::libfabric)
        set(LIBFABRIC_PREFIX "${CMAKE_BINARY_DIR}/libfabric-install")

        FetchContent_Declare(libfabric_ext
            GIT_REPOSITORY https://github.com/ofiwg/libfabric.git
            GIT_TAG v2.1.0
        )

        FetchContent_GetProperties(libfabric_ext)
        if(NOT libfabric_ext_POPULATED)
            FetchContent_Populate(libfabric_ext)
        endif()

        set(LIBFABRIC_SRC_DIR ${libfabric_ext_SOURCE_DIR})
        set(LIBFABRIC_BIN_DIR ${CMAKE_BINARY_DIR}/libfabric-build)
        set(LIBFABRIC_INSTALL_DIR ${CMAKE_BINARY_DIR}/libfabric-install)

        ExternalProject_Add(libfabric_ext_build
            SOURCE_DIR      ${LIBFABRIC_SRC_DIR}
            INSTALL_DIR     ${LIBFABRIC_INSTALL_DIR}
            CONFIGURE_COMMAND ./autogen.sh && ./configure --prefix=${LIBFABRIC_INSTALL_DIR}
            BUILD_COMMAND    make -j
            INSTALL_COMMAND  make install
            BUILD_IN_SOURCE  1
        )


        add_library(libfabric::libfabric STATIC IMPORTED GLOBAL)
        set_target_properties(libfabric::libfabric PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${LIBFABRIC_SRC_DIR}/include"
            IMPORTED_LOCATION "${LIBFABRIC_INSTALL_DIR}/lib/libfabric.a"
        )
        add_dependencies(libfabric::libfabric libfabric_ext_build)
        
        message(STATUS "libfabric downloaded and built by netio4")
    endif()
elseif()
    message("libfabric::libfabric target already present - netio will not do anything about it")
endif()

if(NOT TARGET libfabric::libfabric)
    message(FATAL_ERROR "Could not find or build libfabric!")
endif()


#########end DEPENDENCY #1 LIBFABRIC#####

#########start DEPENDENCY #2 ZMQ#####
option(NETIO4_FORCE_USE_BUILTIN_ZEROMQ "Force netio4 building ZeroMQ via FetchContent" OFF)

if(NETIO4_BUILD_TESTS)
message("ZMQ needed for netio4 tests: trying to get it")
# === Priority 1: target already defined which we are included in another cmake  project which already provides it===
if(NOT TARGET libzmq)

    # === Priority 2: System-provided ===
    if(NOT NETIO4_FORCE_USE_BUILTIN_ZEROMQ)
        find_package(libzmq CONFIG QUIET)

        if(NOT TARGET libzmq)
            find_package(PkgConfig QUIET)
            if(PKG_CONFIG_FOUND)
                pkg_check_modules(ZMQ QUIET libzmq)
            endif()

            if(ZMQ_FOUND AND ZMQ_LIBRARIES)
                add_library(libzmq UNKNOWN IMPORTED)
                set_target_properties(libzmq PROPERTIES
                    IMPORTED_LOCATION "${ZMQ_LIBRARIES}"
                    INTERFACE_INCLUDE_DIRECTORIES "${ZMQ_INCLUDE_DIRS}"
                    INTERFACE_COMPILE_OPTIONS "${ZMQ_CFLAGS_OTHER}"
                )
                message(STATUS "ZeroMQ found by netio4 via pkg-config")
                add_library(netio4zmq ALIAS libzmq)
            endif()
        else()
            message(STATUS "ZeroMQ found by netio4 via find_package")
            add_library(netio4zmq ALIAS libzmq)
        endif()
    elseif()
        message("Skipping discovery of system installed ZeroMQ for netio4 as requested by setting NETIO4_FORCE_USE_LOCAL_ZEROMQ")
    endif()

    # === Priority 3: FetchContent build ===
    if(NOT TARGET libzmq)
        include(FetchContent)

        FetchContent_Declare(
            libzmq
            GIT_REPOSITORY https://github.com/zeromq/libzmq.git
            GIT_TAG v4.3.5
        )

        set(ENABLE_DRAFTS OFF CACHE BOOL "" FORCE)
        set(BUILD_SHARED ON CACHE BOOL "" FORCE)
        set(BUILD_STATIC OFF CACHE BOOL "" FORCE)

        FetchContent_MakeAvailable(libzmq)
    
        add_library(netio4zmq ALIAS libzmq)

        message(STATUS "ZeroMQ built downloaded via FetchContent by netio4 and built")
    endif()
elseif()
    message(STATUS "ZeroMQ::ZeroMQ target already exists and will be used by netio4")
    add_library(netio4zmq ALIAS libzmq)
endif()

# === Final check ===
if(NOT TARGET netio4zmq)
    message(FATAL_ERROR "Failed to find or build ZeroMQ!")
endif()

endif() 

#########end DEPENDENCY #2 ZMQ##
 

#########end FIND DEPENDENCIES#####


## SOURCES AND TARGETS ##

set(NETIO_SOURCES src/netio.cpp src/serialization.cpp src/posix.cpp  src/sockcfg.cpp src/endpoint.cpp
	src/message.cpp src/eventloop.cpp src/backend.cpp src/sockets.cpp src/context.cpp src/buffer.cpp)

add_library(netio STATIC ${NETIO_SOURCES})
target_include_directories(netio PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
    $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>    
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)

target_link_libraries(netio PUBLIC tbb::tbb)
target_link_libraries(netio PRIVATE rt libfabric::libfabric)

install(TARGETS netio
    EXPORT netioTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  )

install(DIRECTORY netio/
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/netio
    FILES_MATCHING
        PATTERN "*.hpp"
)

# Install the export set for use with the install-tree
install(EXPORT netioTargets
  NAMESPACE netio::
  DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}
)

include(CMakePackageConfigHelpers)

write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/netioConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY SameMajorVersion
)

configure_package_config_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/netioConfig.cmake.in
    "${CMAKE_CURRENT_BINARY_DIR}/netioConfig.cmake"
    INSTALL_DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}
)

install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/netioConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/netioConfigVersion.cmake"
    DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}
)

if(NETIO4_BUILD_TESTS)
set(NETIO_TEST_SOURCES test/test_main.cpp test/test_backend.cpp  test/test_buffer.cpp
    test/test_event_loop.cpp test/test_message.cpp  test/test_serialization.cpp test/test_sockets.cpp )
    
add_executable(netio_test ${NETIO_TEST_SOURCES})
target_link_libraries(netio_test netio rt pthread)

add_executable(netio_cat src/main_cat.cpp)
target_link_libraries(netio_cat netio rt pthread)

add_executable(netio_throughput src/main_throughput.cpp)
target_link_libraries(netio_throughput netio rt pthread)

add_executable(netio_bw src/main_bw.cpp)
target_link_libraries(netio_bw netio rt pthread)

add_executable(netio_pingpong src/main_pingpong.cpp)
target_link_libraries(netio_pingpong netio rt pthread)

add_executable(netio_data_pub src/main_data_pub.cpp)
target_link_libraries(netio_data_pub netio rt pthread)

add_executable(netio_recv src/main_recv.cpp)
target_link_libraries(netio_recv netio rt pthread)

add_executable(netio_zeromq src/main_zeromq.cpp)
target_link_libraries(netio_zeromq rt pthread netio4zmq)

add_executable(netio_zeromq_pingpong src/main_zeromq_pingpong.cpp)
target_link_libraries(netio_zeromq_pingpong rt pthread netio4zmq)

add_executable(netio_zeromq_recv src/main_zeromq_recv.cpp)
target_link_libraries(netio_zeromq_recv rt pthread netio4zmq)

install(TARGETS netio_test netio_cat netio_throughput netio_bw netio_pingpong netio_data_pub netio_recv netio_zeromq netio_zeromq_pingpong netio_zeromq_recv
    EXPORT netioTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  )

endif()
