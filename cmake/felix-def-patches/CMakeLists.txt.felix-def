cmake_minimum_required(VERSION 3.15)

project(felix-def VERSION 0.0.1)

include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(CMAKE_CONFIG_INSTALL_DIR "${CMAKE_INSTALL_LIBDIR}/cmake/felix-def")

add_library(felix-def INTERFACE)
add_library(felix-def::felix-def ALIAS felix-def)

target_include_directories(felix-def
  INTERFACE
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)

install(
  TARGETS felix-def
  EXPORT felix-defTargets
  INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
)

install(
  DIRECTORY include/felix
  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/felix
  FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp"
)

install(
  EXPORT felix-defTargets
  NAMESPACE felix-def::
  FILE felix-defTargets.cmake
  DESTINATION ${CMAKE_CONFIG_INSTALL_DIR}
)

write_basic_package_version_file(
  "${CMAKE_CURRENT_BINARY_DIR}/felix-defConfigVersion.cmake"
  VERSION ${PROJECT_VERSION}
  COMPATIBILITY SameMajorVersion
)

configure_package_config_file(
  "${CMAKE_CURRENT_SOURCE_DIR}/cmake/Config.cmake.in"
  "${CMAKE_CURRENT_BINARY_DIR}/felix-defConfig.cmake"
  INSTALL_DESTINATION "${CMAKE_CONFIG_INSTALL_DIR}"
)

install(
  FILES
    "${CMAKE_CURRENT_BINARY_DIR}/felix-defConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/felix-defConfigVersion.cmake"
  DESTINATION "${CMAKE_CONFIG_INSTALL_DIR}"
)
