cmake_minimum_required(VERSION 3.15)

project(felix-interface VERSION 0.0.1 LANGUAGES CXX)

include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(CMAKE_CONFIG_INSTALL_DIR "${CMAKE_INSTALL_LIBDIR}/cmake/felix-interface")


add_library(felix-interface INTERFACE)
add_library(felix-interface::felix-interface ALIAS felix-interface)

# felix-def provides felix_fid.h, felix_ports.h, etc.
# It will already be available as a target when built via YARR's FetchContent chain
if(TARGET felix-def::felix-def)
  target_link_libraries(felix-interface INTERFACE felix-def::felix-def)
else()
  # Fallback: if used standalone, find or fetch felix-def
  find_package(felix-def CONFIG QUIET)
  if(TARGET felix-def::felix-def)
    target_link_libraries(felix-interface INTERFACE felix-def::felix-def)
  endif()
endif()

target_compile_features(felix-interface INTERFACE cxx_std_20)

target_include_directories(felix-interface
  INTERFACE
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)

install(
  TARGETS felix-interface
  EXPORT felix-interfaceTargets
  INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
)


install(
  DIRECTORY felix
  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  FILES_MATCHING
    PATTERN "*.h"
    PATTERN "*.hh"
    PATTERN "*.hpp"
    PATTERN "*.hxx"
)

install(
  EXPORT felix-interfaceTargets
  NAMESPACE felix-interface::
  FILE felix-interfaceTargets.cmake
  DESTINATION ${CMAKE_CONFIG_INSTALL_DIR}
)

write_basic_package_version_file(
  "${CMAKE_CURRENT_BINARY_DIR}/felix-interfaceConfigVersion.cmake"
  VERSION ${PROJECT_VERSION}
  COMPATIBILITY SameMajorVersion
)

configure_package_config_file(
  "${CMAKE_CURRENT_SOURCE_DIR}/felix-interfaceConfig.cmake.in"
  "${CMAKE_CURRENT_BINARY_DIR}/felix-interfaceConfig.cmake"
  INSTALL_DESTINATION "${CMAKE_CONFIG_INSTALL_DIR}"
)

install(
  FILES
    "${CMAKE_CURRENT_BINARY_DIR}/felix-interfaceConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/felix-interfaceConfigVersion.cmake"
  DESTINATION "${CMAKE_CONFIG_INSTALL_DIR}"
)
