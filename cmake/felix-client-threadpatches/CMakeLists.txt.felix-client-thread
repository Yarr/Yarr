cmake_minimum_required(VERSION 3.15)

project(felix-client-thread LANGUAGES CXX VERSION 0.0.1)

include(GNUInstallDirs)

#assume that it has been checked out by git module
add_subdirectory(felix-interface)

set(CMAKE_THREAD_PREFER_PTHREAD TRUE)
set(THREADS_PREFER_PTHREAD_FLAG TRUE)
find_package(Threads REQUIRED)

set(CMAKE_POSITION_INDEPENDENT_CODE TRUE)

add_library(felix-client-thread SHARED src/felix_client_thread.cpp)
target_link_libraries(felix-client-thread PUBLIC ${CMAKE_DL_LIBS} Threads::Threads felix-interface)
target_include_directories(felix-client-thread PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)
   
install(TARGETS felix-client-thread
    EXPORT felix-client-threadTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
  )
  
install(DIRECTORY felix/
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/felix
    FILES_MATCHING
        PATTERN "*.hpp"
)

# Install the export set for use with the install-tree
install(EXPORT felix-client-threadTargets
  NAMESPACE felix::
  DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}/felix-client-thread
)

include(CMakePackageConfigHelpers)

write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/felix-client-threadConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY SameMajorVersion
)

configure_package_config_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/felix-client-threadConfig.cmake.in
    "${CMAKE_CURRENT_BINARY_DIR}/felix-client-threadConfig.cmake"
    INSTALL_DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}/felix-client-thread
)

install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/felix-client-threadConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/felix-client-threadConfigVersion.cmake"
    DESTINATION ${CMAKE_CONFIG_INSTALL_PATH}/felix-client-thread
)
