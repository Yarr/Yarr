{
  "ctrlCfg": {
    "type": "FelixClient",
    "cfg": {
      "FelixClient": {
        "localIPorInterface": "lo",
        "busDir": "/tmp/bus",
        "busGroupName": "FELIX",
        "verboseBus": false,
        "useASIOevloop": true,
        "useThreadUnsafeNetio": true
      },
      "ToFLX": {
        "detectorID": 0,
        "connectorID": 0,
        "protocol": 0,
        "flip": false,
        "broadcast": false,
        "pixFwTrigger": true,
        "bufferSize": 1024,
        "idleWords": [170,170],
        "isCmdEmptyWaitTime": 0
      },
      "ToHost": {
        "detectorID": 0,
        "connectorID": 0,
        "protocol": 0,
        "enableMonitor": false,
        "monitorInterval": 1000,
        "queueLimitMB": 4000,
        "waitTime": 10,
        "flushWaitTime": 0
      },
      "Card": {
        "configureEncodingDecoding": false,
        "txEncoding": 4,
        "rxDecoding": 3,
        "txBandWidth": 160,
        "rxBandWidth": 1280
      }
    }
  }
}
