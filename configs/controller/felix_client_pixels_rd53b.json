{
  "ctrlCfg": {
    "type": "FelixClient",
    "cfg": {
      "FelixClient": {
        "localIPorInterface": "lo",
        "busDir": "/tmp/bus",
        "busGroupName": "FELIX",
        "verboseBus": false,
        "useASIOevloop": true,
        "useThreadUnsafeNetio": true
      },
      "ToFLX": {
        "detectorID": 0,
        "connectorID": 0,
        "protocol": 0,
        "flip": false,
        "broadcast": false,
        "pixFwTrigger": true,
        "bufferSize": 1024,
        "idleWords": [170,170],
        "isCmdEmptyWaitTime": 0
      },
      "ToHost": {
        "detectorID": 0,
        "connectorID": 0,
        "protocol": 0,
        "enableMonitor": false,
        "monitorInterval": 1000,
        "queueLimitMB": 4000,
        "waitTime": 10,
        "flushWaitTime": 0
      },
      "Card": {
        "configureEpathOnLoad": false,
        "txEncoding": 4,
        "rxDecoding": 3,
        "txBandWidth": 160,
        "rxBandWidth": 1280,

        "WriteFelixRegsOnLoad": true,
        "Reg": {
          "DECODING_REVERSE_10B" : "0x1",
          "DECODING_MASK64B66BKBLOCK" : "0x0",
          "ITKPIX_VERSION_00": "0x0000",
          "ITKPIX_VERSION_01": "0x0000",
          "ITKPIX_VERSION_02": "0x0000",
          "ITKPIX_VERSION_03": "0x0000",
          "ITKPIX_VERSION_04": "0x0000",
          "ITKPIX_VERSION_05": "0x0000",
          "ITKPIX_VERSION_06": "0x0000",
          "ITKPIX_VERSION_07": "0x0000",
          "ITKPIX_VERSION_08": "0x0000",
          "ITKPIX_VERSION_09": "0x0000",
          "ITKPIX_VERSION_10": "0x0000",
          "ITKPIX_VERSION_11": "0x0000",
          "ITKPIX_VERSION_12": "0x0000",
          "ITKPIX_VERSION_13": "0x0000",
          "ITKPIX_VERSION_14": "0x0000",
          "ITKPIX_VERSION_15": "0x0000",
          "ITKPIX_VERSION_16": "0x0000",
          "ITKPIX_VERSION_17": "0x0000",
          "ITKPIX_VERSION_18": "0x0000",
          "ITKPIX_VERSION_19": "0x0000",
          "ITKPIX_VERSION_20": "0x0000",
