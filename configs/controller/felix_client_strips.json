      "ToHost": {
        "detectorID": 0,
        "connectorID": 0,
        "protocol": 0,
        "flushWaitTime": 0,
        "enableMonitor": true,
        "monitorInterval": 1000,
        "queueLimitMB": 4000,
        "waitTime": 10000
      }
    }
  }
}
