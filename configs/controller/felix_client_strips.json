{
  "ctrlCfg": {
    "type": "FelixClient",
    "cfg": {
      "FelixClient": {
        "localIPorInterface": "lo",
        "busDir": "/tmp/bus",
        "busGroupName": "FELIX",
        "verboseBus": false,
        "useASIOevloop": true, 
